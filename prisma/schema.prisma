// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  password   String
  role       String   @default("USER") // "USER" | "ADMIN"
  // 2FA fields
  totpSecret String?  // TOTP secret for Google Authenticator
  totpEnabled Boolean @default(false) // whether 2FA is enabled
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String?
  email       String
  projectType String?
  budget      String?
  message     String?
  source      String   @default("contact-form")
  // Project inquiry workflow
  status      String   @default("new") // "new" | "reviewed" | "quoted" | "won" | "lost"
  quoteAmount String?  // optional quote amount (e.g. "TZS 950,000")
  notes       String?  // internal admin notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

// === Rate limiting — tracks failed login attempts by IP ===
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

// === Admin-managed portfolio projects ===
model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  description String   // short teaser shown on the card
  tag         String   @default("Web")
  accent      String   @default("from-[#1B4332] to-[#143A2B]")
  brief       String   @default("")
  challenges  String   @default("")
  solution    String   @default("")
  results     String   @default("")
  thumbnail   String?
  previewUrl  String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

// === Admin-managed blog posts ===
model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String   @default("")
  content   String   @default("")
  category  String   @default("Insights")
  date      String
  readTime  String   @default("5 min read")
  coverImage String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

// === Admin-managed client logos ===
model Client {
  id        String   @id @default(cuid())
  name      String
  logoData  String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

// === Admin-managed testimonials ===
model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String   @default("")
  company   String   @default("")
  photoData String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}
